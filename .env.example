# Copy to .env and replace every placeholder before starting Docker Compose.
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-root-password
MYSQL_APP_PASSWORD=replace-with-a-different-long-random-password
REDIS_PASSWORD=replace-with-a-long-random-redis-password
JWT_SECRET=replace-with-at-least-32-random-bytes
AES_KEY=replace-with-16-24-or-32-bytes
WX_APPID=replace-with-wechat-app-id
WX_SECRET=replace-with-wechat-app-secret
ADMIN_USERNAME=replace-with-initial-admin-username
ADMIN_PASSWORD=replace-with-at-least-12-random-characters
CORS_ALLOWED_ORIGIN=https://your-admin-domain.example
FILE_UPLOAD_URL=https://your-domain.example/uploads
TOTAL_MARCH_DISTANCE=25000
